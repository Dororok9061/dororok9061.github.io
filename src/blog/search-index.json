---
layout: null
permalink: /blog/search-index.json
sitemap: false
---
[
{% assign public_posts = site.posts | where_exp: 'post', 'post.draft != true' %}
{% for post in public_posts %}
  {
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "category": {{ post.primary_category | default: post.categories.first | jsonify }},
    "subcategory": {{ post.subcategory | jsonify }},
    "series": {{ post.series | jsonify }},
    "tools": {{ post.tools | join: ' ' | jsonify }},
    "tags": {{ post.tags | join: ' ' | jsonify }},
    "headings": {{ post.toc | map: 'title' | join: ' ' | jsonify }},
    "date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
    "lang": {{ post.lang | jsonify }},
    "url": {{ post.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
